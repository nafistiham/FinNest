# FinNest Admin (apps/console) configuration. Copy to .env and fill in; .env is gitignored.
# The API does not read .env itself: export the variables, or load the file with your shell
# (for example `set -a; . ./.env; set +a`) before tools/dev.sh or uvicorn.

# --- sign-in (api/auth.py) ---------------------------------------------------------------------
# Unset ADMIN_PASSWORD / SESSION_SECRET fall back to local-dev defaults. On Cloud Run (K_SERVICE set)
# the API refuses to start without real values.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string
TOKEN_HOURS=12

# --- services the console reads ----------------------------------------------------------------
# risk-mw base URL, reported on /health. Local risk-mw: http://localhost:8080
RISK_MW_URL=
# Case Zero base URL, read server-side for the Cases view. Local Case Zero: http://localhost:8090
CASE_ZERO_URL=
# Google Cloud project that holds risk-mw's Firestore audit collection (the Logs view).
# Unset uses the application-default credentials' project.
PROJECT_ID=your-gcp-project-id

# --- Gemini reading in the audit drawer (read by risk-mw's vendored settings) ------------------
RISK_MW_GENAI_ENABLED=false
RISK_MW_PROJECT_ID=your-gcp-project-id
RISK_MW_GENAI_BUDGET_USD=1.00
# true: one full warm-up reading at start-up, so the first real reading is not a cold one.
FINNEST_ADMIN_GEMINI_WARM_UP_CALL=false

# --- optional data paths -----------------------------------------------------------------------
# A JSONL file of behaviour enrolment sessions; without it the scenario's behaviour step reports "off".
CONSOLE_ATO_SESSIONS=
# Defaults: models/mule and models/ato at the repo root.
# RISK_MW_MULE_ARTEFACTS_DIR=
# RISK_MW_ATO_ARTEFACTS_DIR=

# --- web build (web/, read by Vite at build time) ----------------------------------------------
# risk-mw base URL the browser calls for live panels. Default: http://localhost:8080
VITE_RISK_MW_URL=

# --- scripts/deploy.sh -------------------------------------------------------------------------
# Required for a deploy: PROJECT_ID and ADMIN_PASSWORD (above).
REGION=asia-southeast1
SERVICE=finnest-admin
# Python used for the test gate in deploy.sh and by tools/dev.sh.
PYTHON=python3
CONSOLE_GEMINI_BUDGET_USD=1.00
CONSOLE_GEMINI_WARM_UP_CALL=true

# --- scripts/smoke.sh --------------------------------------------------------------------------
CONSOLE_URL=http://127.0.0.1:8099
