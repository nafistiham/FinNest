<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, non-capturing configuration: only click events, no window-content retrieval,
     no key-event filtering, no touch exploration, no fingerprint gestures. The service exists
     so the OS lists an *enabled* accessibility service for com.demo.takanow; it reads nothing. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_description"
    android:accessibilityEventTypes="typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false" />
