# Copy to .env (git-ignored). Recommended: Vertex AI with your own login, no API key:
#   gcloud auth login --update-adc && gcloud config set project <your-gcp-project-id>
CASE_ZERO_PROJECT_ID=<your-gcp-project-id>
CASE_ZERO_LOCATION=global
# Hard cap on Gemini spend across all runs on this machine (ledger in .spend.json):
CASE_ZERO_BUDGET_USD=1.40
# Proxies that append to X-Forwarded-For (per-IP rate limit): 1 for run.app, 2 behind an external load balancer, 0 locally.
# With 2, close the run.app URL (ingress internal-and-cloud-load-balancing). Otherwise callers can skip the balancer and pick their own address.
# CASE_ZERO_TRUSTED_HOPS=1
# Optional: needed only for POST /api/cases/{id}/approve
CASE_ZERO_ADMIN_TOKEN=
# Vertex AI is used whenever CASE_ZERO_PROJECT_ID is set. To force a Gemini API key instead:
# CASE_ZERO_BACKEND=api_key and GOOGLE_API_KEY=
# risk-mw, for the device_safety tool (the App Safety Check verdict per customer). Empty = the tool answers known=false.
# Local example: http://localhost:8080
CASE_ZERO_RISK_MW_URL=
# Optional: the repository root, when Case Zero runs outside the repository layout.
# CASE_ZERO_PROJECT_DIR=
