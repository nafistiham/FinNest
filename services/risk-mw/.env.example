# risk-mw settings for a local run. The service reads the environment only (no .env loader):
#   set -a; . ./.env; set +a
# Every setting is optional. The defaults run in demo mode with no cloud access.

# Google Cloud (needed for Gemini on Vertex AI and for Firestore). Log in with:
#   gcloud auth application-default login
RISK_MW_PROJECT_ID=<your-gcp-project-id>
RISK_MW_REGION=asia-southeast1
RISK_MW_GENAI_LOCATION=global

# Switches
RISK_MW_DEMO_MODE=true
RISK_MW_AUTH_REQUIRED=false
RISK_MW_FIRESTORE_ENABLED=false
RISK_MW_GENAI_ENABLED=false
RISK_MW_TTS_ENABLED=false
RISK_MW_GENAI_BUDGET_USD=5

# Model artefacts, relative to services/risk-mw. Unset = that signal is off.
RISK_MW_MULE_ARTEFACTS_DIR=../../models/mule
RISK_MW_APPSAFETY_ARTEFACTS_DIR=../../models/app-safety-check
# Behaviour models are not published; set this only when you trained them (libs/ato/README.md).
# RISK_MW_ATO_ARTEFACTS_DIR=../../models/ato

# Case Zero base URL, for example http://localhost:8090. Empty = the scripted stub answers.
RISK_MW_INVESTIGATOR_URL=

# Secrets. Empty = a random value per process (fine for one local instance).
RISK_MW_DEMO_INTEGRITY_SECRET=
RISK_MW_APA_TOKEN_SECRET=
RISK_MW_OPERATOR_TOKEN=
